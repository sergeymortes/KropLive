<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Доступ к интернету -->
    <uses-permission
        android:name="android.permission.INTERNET" />

    <!-- Уведомления -->
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Точное планирование предупреждений о свете -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Восстановление уведомлений после перезагрузки -->
    <uses-permission
        android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Фоновый мониторинг NEPTUN -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE" />

    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Установка обновлений Кроп Live через GitHub Releases -->
    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KropiLive">

        <!-- Главный экран приложения -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:hardwareAccelerated="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.KropiLive"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action
                    android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Доступ системного установщика к APK обновления -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updateprovider"
            android:exported="false"
            android:grantUriPermissions="true">

            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />

        </provider>

        <!-- Запланированные уведомления о свете -->
        <receiver
            android:name=".background.ElectricityAlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- Восстановление после перезагрузки и обновления -->
        <receiver
            android:name=".background.ElectricityBootReceiver"
            android:enabled="true"
            android:exported="false">

            <intent-filter>
                <action
                    android:name="android.intent.action.BOOT_COMPLETED" />

                <action
                    android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>

        </receiver>

        <!-- Постоянный мониторинг NEPTUN -->
        <service
            android:name=".background.AirAlertMonitorService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
